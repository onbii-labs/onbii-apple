<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Onbii</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Onbii Knowledge Object</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<!-- Onbii exports org.onbii.bundle, so it is the owner of the type
			     rather than one of several apps that can open it. Viewer plus
			     Owner is the honest pair: it defines the format and reads it,
			     and it is not the only thing allowed to. -->
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.onbii.bundle</string>
			</array>
			<key>LSTypeIsPackage</key>
			<true/>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Onbii records where a recording was captured, so you can remember where a conversation happened. Location is optional and stays in your archive.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Onbii records audio only after you tap Record, so it can preserve the recording as an object you control.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Onbii transcribes your recordings entirely on this device after you tap Transcribe. Audio is never sent to a server.</string>
	<!--
		A recording has to survive the ordinary things people do while talking:
		the screen locking itself, and looking something up mid-conversation.
		Without this the system suspends the app and the recorder stops — which
		is why the first field test's 09:02 recording is 44 seconds long and
		nothing said so.

		`audio` is exactly what this mode is for, and Onbii's use of it is
		literal: it records audio, only after someone taps Record (spec decision
		0023 — recording is always explicit, never hidden).
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.yepyr.onbii</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Onbii</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>OnbiiForest</string>
		<key>UIImageName</key>
		<string>OnbiiWordmark</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Onbii Knowledge Object</string>
			<key>UTTypeIdentifier</key>
			<string>org.onbii.bundle</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>onbii</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Export compliance. Onbii makes no network calls at all: capture,
	     transcription and storage are entirely on-device, and there is no
	     custom cryptography. Declared here so App Store Connect stops asking
	     the same question on every single upload. Re-check this the day
	     anything in the app talks to a server. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
